
<!DOCTYPE HTML>
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Adminise - Clean And Corporate Admin Panel Template</title>
<!--// Stylesheets //-->
<link href="css/test.css" rel="stylesheet" media="screen" />
<link href="css/test-bootstrap.css" rel="stylesheet" media="screen" />
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />

</head>

<body>
<!-- Wrapper Start -->
<div class="wrapper">
	<div class="structure-row alone">
        <!-- Right Section Start -->
        <div class="right-sec">
            <!-- Right Section Header Start -->
            <header>
                <!-- User Section Start -->
                <div class="logo">
                    <img src="images/logo1.png" alt="Adminise" />
                </div>

				<div class="search-box">
                    <div class="user">
						<figure>
							<a href="#"><img src="images/profile-img.jpg" alt="Adminise" /></a>
						</figure>
						<div class="welcome">
							<p>Name : <b>Aakarsh Gautam</b></p>
							<p>Roll No : <b>100001</b></p>
							<p>Reg. No : <b>NA</b></p>
						</div>
					</div>
                </div>

                <!-- User Section End -->
                <div class="topnav">
					<div class="clockdiv">
						<div class="time-left">Time Left :</div>
						<div><span class="hours">01</span></div>
						<div><span class="minutes">59</span></div>
						<div><span class="seconds">53</span></div>
					</div>
				</div>

                <!-- Header Top Navigation End -->
                <div class="clearfix"></div>
            </header>
            <!-- Right Section Header End -->
            <!-- Content Section Start -->
            <div class="content-section">
                <div class="container-liquid">
                    <div class="row">

                        <div class="col-md-9">
                            <div class="key-box">
                                <h2>Question - 1 ::</h2>
								<p>
									If an entrepreneur takes decisions for survival of their enterprise, it is known as<br>
									यदि एक उद्यमी अपने उद्यम के अस्तित्व के लिए निर्णय लेता है, तो इसे जाना जाता है
								</p>
								<div class="answer">
									<label>
										<input type="radio" id="answer1" name="Answer" value="Strategic Decisions">
										<div>Strategic Decisions / सामरिक निर्णय</div>
									</label>
								</div>
								<div class="answer">
									<label>
										<input type="radio" id="answer2" name="Answer" value="Routine Decisions">
										<div>Routine Decisions / नियमित निर्णय</div>
									</label>
								</div>
								<div class="answer">
									<label>
										<input type="radio" id="answer3" name="Answer" value="Personal Decisions">
										<div>Personal Decisions / व्यक्तिगत निर्णय</div>
									</label>
								</div>
								<div class="answer">
									<label>
										<input type="radio" id="answer4" name="Answer" value="Organisational Decisions">
										<div>Organisational Decisions / संगठनात्मक निर्णय</div>
									</label>
								</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="key-box">
								<h3 class="fancy">MOCK-Q (10)</h3>
								<div class="question-list">
									<a href="#"><span class="wrong">1</span></a>
									<a href="#"><span class="unattempt">2</span></a>
									<a href="#"><span class="unattempt">3</span></a>
									<a href="#"><span class="unattempt">4</span></a>
									<a href="#"><span class="unattempt">5</span></a>
									<a href="#"><span class="unattempt">6</span></a>
									<a href="#"><span class="unattempt">7</span></a>
									<a href="#"><span class="unattempt">8</span></a>
									<a href="#"><span class="unattempt">9</span></a>
									<a href="#"><span class="unattempt">10</span></a>

									<div class="clearfix"></div>
								</div>

								<div class="question-list">
									<a href="#"><span class="right">1</span></a>
									<a href="#"><span class="right">2</span></a>
									<a href="#"><span class="unattempt">3</span></a>
									<a href="#"><span class="right">4</span></a>
									<a href="#"><span class="marked-answer"><span class="marked-txt">5</span></span></a>
									<a href="#"><span class="marked-answer"><span class="marked-txt">6</span></span></a>
									<a href="#"><span class="marked-answer"><span class="marked-txt">7</span></span></a>
									<a href="#"><span class="unattempt">8</span></a>
									<a href="#"><span class="unattempt">9</span></a>
									<a href="#"><span class="wrong">10</span></a>
									<a href="#"><span class="marked-answer-right"><span class="marked-right-txt">11</span></span></a>

									<div class="clearfix"></div>
								</div>

                            </div>
                        </div>
                    </div>
                    <!-- Row End -->
                </div>
            </div>
            <!-- Content Section End -->
			<div class="footer">
				<div class="left-btns">
					<button class="previous-btn" role="button"><< Previous</button>
					<button class="save-btn" role="button">Save and Mark</button>
					<button class="response-btn" role="button">Clear Response</button>
				</div>
				<div class="right-btns">
					<div class="save-nxt-btn">
						<button class="proceed-btn" role="button">Save & Next >></button>
					</div>
					<div class="instruct-btn">
						<span class="attempt">10</span>
						<span class="marked-answer-right"><span class="marked-right-txt">0</span></span>
						<span class="marked-answer"><span class="marked-txt">0</span></span>
						<span class="unattempt">10</span>
						<button class="submit-btn" role="button">Submit Exam</button>
					</div>
				</div>
				<div class="clearfix"></div>

			</div>
        </div>
        <!-- Right Section End -->
    </div>
</div>
<!-- Wrapper End -->
</body>
</html>
